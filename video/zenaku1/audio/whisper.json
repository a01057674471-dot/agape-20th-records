[{"start": 0.0, "end": 8.22, "text": "開けてはいけない玉手箱、覗いてはいけない木織の部屋、日本の昔話にもたった一つの約束が出てきますよね。", "words": [[0.0, 0.32, "開"], [0.32, 0.48, "けて"], [0.48, 0.72, "はい"], [0.72, 0.94, "け"], [0.94, 1.08, "ない"], [1.08, 1.42, "玉"], [1.42, 1.56, "手"], [1.56, 1.84, "箱、"], [2.12, 2.36, "覗"], [2.36, 2.6, "いて"], [2.6, 2.82, "はい"], [2.82, 3.02, "け"], [3.02, 3.16, "ない"], [3.16, 3.48, "木"], [3.48, 3.58, "織"], [3.58, 3.74, "の"], [3.74, 3.9, "部"], [3.9, 4.08, "屋、"], [4.42, 4.66, "日本"], [4.66, 4.86, "の"], [4.86, 5.18, "昔"], [5.18, 5.34, "話"], [5.34, 5.58, "に"], [5.58, 5.86, "も"], [5.86, 6.2, "た"], [6.2, 6.38, "った"], [6.38, 6.5, "一"], [6.5, 6.68, "つ"], [6.68, 6.8, "の"], [6.8, 6.94, "約"], [6.94, 7.14, "束"], [7.14, 7.34, "が"], [7.34, 7.56, "出"], [7.56, 7.66, "て"], [7.66, 7.9, "きます"], [7.9, 8.22, "よね。"]]}, {"start": 8.5, "end": 16.56, "text": "聖書の一番最初にもそんな話があります。神様は最初の人間、アダムとエヴァに美しいそのを与えました。", "words": [[8.5, 8.68, "聖"], [8.68, 8.8, "書"], [8.8, 8.92, "の"], [8.92, 9.12, "一"], [9.12, 9.32, "番"], [9.32, 9.54, "最"], [9.54, 9.66, "初"], [9.66, 9.76, "に"], [9.76, 9.96, "も"], [9.96, 10.42, "そんな"], [10.42, 10.72, "話"], [10.72, 10.92, "が"], [10.92, 11.22, "あります。"], [11.74, 11.92, "神"], [11.92, 12.14, "様"], [12.14, 12.5, "は"], [12.5, 12.86, "最"], [12.86, 13.02, "初"], [13.02, 13.16, "の"], [13.16, 13.3, "人"], [13.3, 13.56, "間、"], [13.94, 14.1, "ア"], [14.1, 14.14, "ダ"], [14.14, 14.28, "ム"], [14.28, 14.4, "と"], [14.4, 14.56, "エ"], [14.56, 14.6, "ヴ"], [14.6, 14.6, "ァ"], [14.6, 14.8, "に"], [14.8, 15.24, "美"], [15.24, 15.62, "しい"], [15.62, 15.82, "その"], [15.82, 16.04, "を"], [16.04, 16.16, "与"], [16.16, 16.28, "え"], [16.28, 16.56, "ました。"]]}, {"start": 17.08, "end": 23.5, "text": "どの木からでも思いのままに食べていい、ほとんど全部が自由だったんです。ただ一つだけ。", "words": [[17.08, 17.16, "ど"], [17.16, 17.34, "の"], [17.34, 17.44, "木"], [17.44, 17.6, "から"], [17.6, 17.86, "でも"], [17.86, 18.34, "思"], [18.34, 18.48, "い"], [18.48, 18.58, "の"], [18.58, 18.68, "ま"], [18.68, 18.82, "ま"], [18.82, 18.9, "に"], [18.9, 19.04, "食べ"], [19.04, 19.26, "て"], [19.26, 19.48, "いい、"], [19.84, 19.98, "ほ"], [19.98, 20.12, "と"], [20.12, 20.22, "ん"], [20.22, 20.34, "ど"], [20.34, 20.82, "全部"], [20.82, 21.12, "が"], [21.12, 21.38, "自由"], [21.38, 21.58, "だ"], [21.58, 21.76, "った"], [21.76, 22.04, "んです。"], [22.36, 22.6, "ただ"], [22.6, 23.04, "一"], [23.04, 23.26, "つ"], [23.26, 23.5, "だけ。"]]}, {"start": 24.0, "end": 31.14, "text": "前悪の知識の木からは食べてはいけない。ちなみに、その身がリンゴだとは聖書には書いてありません。", "words": [[24.0, 24.36, "前"], [24.36, 24.62, "悪"], [24.62, 24.76, "の"], [24.76, 24.96, "知"], [24.96, 25.12, "識"], [25.12, 25.28, "の"], [25.28, 25.42, "木"], [25.42, 25.6, "から"], [25.6, 25.82, "は"], [25.82, 26.22, "食べ"], [26.22, 26.4, "て"], [26.4, 26.62, "はい"], [26.62, 26.76, "け"], [26.76, 26.94, "ない。"], [27.34, 27.62, "ち"], [27.62, 27.72, "な"], [27.72, 27.86, "み"], [27.86, 28.16, "に、"], [28.32, 28.48, "その"], [28.48, 28.66, "身"], [28.66, 28.8, "が"], [28.8, 28.96, "リ"], [28.96, 29.04, "ン"], [29.04, 29.14, "ゴ"], [29.14, 29.26, "だ"], [29.26, 29.38, "と"], [29.38, 29.54, "は"], [29.54, 29.96, "聖"], [29.96, 30.08, "書"], [30.08, 30.28, "には"], [30.28, 30.48, "書"], [30.48, 30.66, "いて"], [30.66, 30.8, "あり"], [30.8, 31.14, "ません。"]]}, {"start": 31.36, "end": 39.14, "text": "この木は何が良くて何が悪いかを神様ではなく自分の好き嫌いで決める道、そう読むことができます。", "words": [[31.36, 31.56, "この"], [31.56, 31.72, "木"], [31.72, 31.96, "は"], [31.96, 32.32, "何"], [32.32, 32.52, "が"], [32.52, 32.66, "良"], [32.66, 32.8, "く"], [32.8, 32.94, "て"], [32.94, 33.32, "何"], [33.32, 33.54, "が"], [33.54, 33.68, "悪"], [33.68, 33.88, "い"], [33.88, 34.0, "か"], [34.0, 34.16, "を"], [34.16, 34.6, "神"], [34.6, 34.82, "様"], [34.82, 34.98, "では"], [34.98, 35.3, "なく"], [35.3, 35.82, "自"], [35.82, 36.04, "分"], [36.04, 36.16, "の"], [36.16, 36.3, "好"], [36.3, 36.4, "き"], [36.4, 36.58, "嫌"], [36.58, 36.7, "い"], [36.7, 36.8, "で"], [36.8, 36.96, "決"], [36.96, 37.06, "め"], [37.06, 37.18, "る"], [37.18, 37.38, "道、"], [38.1, 38.22, "そう"], [38.22, 38.4, "読"], [38.4, 38.5, "む"], [38.5, 38.64, "こと"], [38.64, 38.82, "が"], [38.82, 38.92, "で"], [38.92, 39.14, "きます。"]]}, {"s