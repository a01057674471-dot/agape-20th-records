う"], [59.76, 60.12, "短"], [60.12, 60.32, "い"], [60.32, 60.44, "言"], [60.44, 60.62, "葉"], [60.62, 60.78, "で、"], [61.06, 61.24, "この"], [61.24, 61.46, "信"], [61.46, 61.66, "仰"], [61.66, 61.78, "を"], [61.78, 61.94, "守"], [61.94, 62.16, "って"], [62.16, 62.26, "き"], [62.26, 62.54, "ました。"]]}, {"start": 63.18, "end": 66.34, "text": "名前ではなく、中身を聖書で確かめてください。", "words": [[63.18, 63.3, "名"], [63.3, 63.5, "前"], [63.5, 63.66, "では"], [63.66, 63.9, "なく、"], [64.26, 64.5, "中"], [64.5, 64.7, "身"], [64.7, 64.86, "を"], [64.86, 65.28, "聖"], [65.28, 65.42, "書"], [65.42, 65.52, "で"], [65.52, 65.7, "確"], [65.7, 65.86, "か"], [65.86, 65.98, "めて"], [65.98, 66.34, "ください。"]]}, {"start": 67.14, "end": 71.32, "text": "本当の福音は、あなたを縛るものではなく、自由にするものです。", "words": [[67.14, 67.36, "本当"], [67.36, 67.62, "の"], [67.62, 67.78, "福"], [67.78, 68.02, "音"], [68.02, 68.2, "は、"], [68.54, 68.64, "あ"], [68.64, 68.82, "なた"], [68.82, 68.98, "を"], [68.98, 69.18, "縛"], [69.18, 69.32, "る"], [69.32, 69.44, "もの"], [69.44, 69.64, "では"], [69.64, 69.9, "なく、"], [70.2, 70.5, "自由"], [70.5, 70.7, "に"], [70.7, 70.88, "する"], [70.88, 71.04, "もの"], [71.04, 71.32, "です。"]]}]