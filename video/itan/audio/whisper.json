[{"start": 0.0, "end": 6.46, "text": "キリスト教っぽいけど、何か違う。 そんな団体の話をニュースで聞いたことはありませんか?", "words": [[0.0, 0.36, "キ"], [0.36, 0.44, "リ"], [0.44, 0.64, "スト"], [0.64, 0.82, "教"], [0.82, 1.06, "っぽ"], [1.06, 1.14, "い"], [1.14, 1.36, "けど、"], [1.64, 1.88, "何"], [1.88, 2.1, "か"], [2.1, 2.4, "違う。"], [3.04, 3.28, " そ"], [3.28, 3.44, "んな"], [3.44, 3.64, "団"], [3.64, 3.78, "体"], [3.78, 3.9, "の"], [3.9, 4.1, "話"], [4.1, 4.4, "を"], [4.4, 4.78, "ニ"], [4.78, 4.84, "ュ"], [4.84, 4.88, "ー"], [4.88, 4.96, "ス"], [4.96, 5.1, "で"], [5.1, 5.26, "聞"], [5.26, 5.4, "いた"], [5.4, 5.54, "こと"], [5.54, 5.76, "は"], [5.76, 5.98, "あり"], [5.98, 6.18, "ません"], [6.18, 6.46, "か?"]]}, {"start": 7.08, "end": 17.18, "text": "キリスト教では、聖書の教えから大きく外れた団体を痛んと呼びます。 名前にキリストや教会が入っていても、中身が同じとは限らないんです。", "words": [[7.08, 7.3, "キ"], [7.3, 7.38, "リ"], [7.38, 7.6, "スト"], [7.6, 7.76, "教"], [7.76, 7.98, "では、"], [8.5, 8.64, "聖"], [8.64, 8.78, "書"], [8.78, 8.9, "の"], [8.9, 9.12, "教"], [9.12, 9.24, "え"], [9.24, 9.42, "から"], [9.42, 9.66, "大"], [9.66, 9.82, "き"], [9.82, 9.92, "く"], [9.92, 10.1, "外"], [10.1, 10.3, "れた"], [10.3, 10.52, "団"], [10.52, 10.72, "体"], [10.72, 10.9, "を"], [10.9, 11.36, "痛"], [11.36, 11.62, "んと"], [11.62, 11.74, "呼"], [11.74, 11.84, "び"], [11.84, 12.06, "ます。"], [12.58, 12.66, " 名"], [12.66, 12.86, "前"], [12.86, 13.02, "に"], [13.02, 13.22, "キ"], [13.22, 13.28, "リ"], [13.28, 13.5, "スト"], [13.5, 13.66, "や"], [13.66, 13.92, "教"], [13.92, 14.1, "会"], [14.1, 14.26, "が"], [14.26, 14.42, "入"], [14.42, 14.62, "って"], [14.62, 14.76, "いて"], [14.76, 14.98, "も、"], [15.34, 15.48, "中"], [15.48, 15.64, "身"], [15.64, 15.76, "が"], [15.76, 15.92, "同"], [15.92, 16.08, "じ"], [16.08, 16.18, "と"], [16.18, 16.34, "は"], [16.34, 16.56, "限"], [16.56, 16.72, "ら"], [16.72, 16.86, "ない"], [16.86, 17.18, "んです。"]]}, {"start": 17.62, "end": 21.16, "text": "では、どう見分けるのか。 ポイントは、三つです。", "words": [[17.62, 17.9, "では、"], [18.26, 18.5, "どう"], [18.5, 18.68, "見"], [18.68, 18.8, "分"], [18.8, 18.96, "ける"], [18.96, 19.1, "の"], [19.1, 19.26, "か。"], [19.66, 19.8, " ポ"], [19.8, 19.9, "イ"], [19.9, 20.0, "ント"], [20.0, 20.22, "は、"], [20.56, 20.66, "三"], [20.66, 20.9, "つ"], [20.9, 21.16, "です。"]]}, {"start": 21.54, "end": 29.0, "text": "一つ目、イエスは誰か。 聖書は、イエスキリストだけが神であり、ただ一人の救い主だと語ります。", "words": [[21.54, 21.72, "一"], [21.72, 21.96, "つ"], [21.96, 22.14, "目、"], [22.62, 22.72, "イ"], [22.72, 22.82, "エ"], [22.82, 22.94, "ス"], [22.94, 23.1, "は"], [23.1, 23.36, "誰"], [23.36, 23.64, "か。"], [24.22, 24.42, " 聖"], [24.42, 24.6, "書"], [24.6, 24.78, "は、"], [25.16, 25.2, "イ"], [25.2, 25.28, "エ"], [25.28, 25.4, "ス"], [25.4, 25.54, "キ"], [25.54, 25.6, "リ"], [25.6, 25.76, "スト"], [25.76, 25.98, "だけ"], [25.98, 26.2, "が"], [26.2, 26.44, "神"], [26.44, 26.6, "で"], [26.6, 26.78, "あり、"], [27.2, 27.34, "ただ"], [27.34, 27.56, "一"], [27.56, 27.72, "人"], [27.72, 27.84, "の"], [27.84, 28.08, "救"], [28.08, 28.22, "い"], [28.22, 28.3, "主"], [28.3, 28.5, "だ"], [28.5, 28.62, "と"], [28.62, 28.74, "語"], [28.74, 29.0, "ります。"]]}, {"start": 29.0, "end": 34.64, "text": "もし、教祖が新しい救い主だというなら、それは聖書と違います。", "words": [[29.0, 29.7, "もし、"], [30.22, 30.42, "教"], [30.42, 30.58, "祖"], [30.58, 30.74, "が"], [30.74, 31.0, "新"], [31.0, 31.34, "しい"], [31.34, 31.54, "救"], [31.54, 31.68, "い"], [31.68, 31.76, "主"], [31.76, 31.96, "だ"], [31.96, 32.2, "という"], [32.2, 32.46, "なら、"], [32.82, 33.2, "それは"], [33.2, 33.54, "聖"], [33.54, 33.64, "書"], [33.64, 33.74, "と"], [33.74, 33.96, "違"], [33.96, 34.64, "います。"]]}, {"start": 34.66, "end": 44.34, "text": "二つ目、何が一番の基準か。 聖書より大切な本や、この団体の解釈だけが正しいという教えがあるなら、注意が必要です。", "words": [[34.66, 34.88, "二"], [34.88, 35.08, "つ"], [35.08, 35.32, "目、"], [35.7, 35.84, "何"], [35.84, 36.08, "が"], [36.08, 36.34, "一"], [36.34, 36.52, "番"], [36.52, 36.68, "の"], [36.68, 36.84, "基"], [36.84, 36.98, "準"], [36.98, 37.2, "か。"], [37.72, 37.9, " 聖"], [37.9, 38.06, "書"], [38.06, 38.2, "よ"], [38.2, 38.28, "り"], [38.28, 38.46, "大"], [38.46, 38.62, "切"], [38.62, 38.82, "な"], [38.82, 39.0, "本"], [39.0, 39.18, "や、"], [39.56, 39.76, "この"], [39.76, 39.96, "団"], [39.96, 40.12, "体"], [40.