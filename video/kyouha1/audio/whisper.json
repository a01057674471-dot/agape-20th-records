[{"start": 0.0, "end": 6.32, "text": "カトリックとプロテスタント。同じキリスト教なのに何が違うの?始まりは一つでした。", "words": [[0.0, 0.36, "カ"], [0.36, 0.46, "ト"], [0.46, 0.56, "リ"], [0.56, 0.7, "ック"], [0.7, 0.86, "と"], [0.86, 1.08, "プ"], [1.08, 1.16, "ロ"], [1.16, 1.28, "テ"], [1.28, 1.4, "ス"], [1.4, 1.5, "タ"], [1.5, 1.64, "ント。"], [2.14, 2.38, "同"], [2.38, 2.6, "じ"], [2.6, 2.74, "キ"], [2.74, 2.78, "リ"], [2.78, 2.94, "スト"], [2.94, 3.12, "教"], [3.12, 3.28, "な"], [3.28, 3.4, "の"], [3.4, 3.58, "に"], [3.58, 4.02, "何"], [4.02, 4.24, "が"], [4.24, 4.52, "違う"], [4.52, 4.74, "の?"], [4.92, 5.08, "始"], [5.08, 5.36, "まり"], [5.36, 5.56, "は"], [5.56, 5.86, "一"], [5.86, 6.06, "つ"], [6.06, 6.32, "でした。"]]}, {"start": 7.04, "end": 12.16, "text": "イエスキリストの弟子たちから始まった教会は長い間一つの流れでした。", "words": [[7.04, 7.22, "イ"], [7.22, 7.28, "エ"], [7.28, 7.42, "ス"], [7.42, 7.56, "キ"], [7.56, 7.62, "リ"], [7.62, 7.78, "スト"], [7.78, 7.92, "の"], [7.92, 8.08, "弟"], [8.08, 8.18, "子"], [8.18, 8.26, "た"], [8.26, 8.38, "ち"], [8.38, 8.54, "から"], [8.54, 8.74, "始"], [8.74, 8.9, "ま"], [8.9, 9.08, "った"], [9.08, 9.26, "教"], [9.26, 9.44, "会"], [9.44, 9.64, "は"], [9.64, 10.22, "長"], [10.22, 10.48, "い"], [10.48, 10.7, "間"], [10.7, 11.2, "一"], [11.2, 11.42, "つ"], [11.42, 11.54, "の"], [11.54, 11.72, "流"], [11.72, 11.88, "れ"], [11.88, 12.16, "でした。"]]}, {"start": 12.76, "end": 16.38, "text": "11世紀、教会は東と西に分かれます。", "words": [[12.76, 13.12, "11"], [13.12, 13.44, "世"], [13.44, 13.62, "紀、"], [14.16, 14.28, "教"], [14.28, 14.46, "会"], [14.46, 14.72, "は"], [14.72, 15.14, "東"], [15.14, 15.46, "と"], [15.46, 15.62, "西"], [15.62, 15.84, "に"], [15.84, 16.0, "分"], [16.0, 16.1, "か"], [16.1, 16.12, "れ"], [16.12, 16.38, "ます。"]]}, {"start": 17.06, "end": 22.64, "text": "東は西教会、西はカトリック教会に、そして1517年。", "words": [[17.06, 17.24, "東"], [17.24, 17.54, "は"], [17.54, 17.78, "西"], [17.78, 18.0, "教"], [18.0, 18.22, "会、"], [18.7, 18.9, "西"], [18.9, 19.14, "は"], [19.14, 19.32, "カ"], [19.32, 19.4, "ト"], [19.4, 19.52, "リ"], [19.52, 19.66, "ック"], [19.66, 19.88, "教"], [19.88, 20.06, "会"], [20.06,