0.42, 40.66, "様"], [40.66, 40.82, "の"], [40.82, 40.96, "恵"], [40.96, 41.16, "み"], [41.16, 41.28, "に"], [41.28, 41.38, "よ"], [41.38, 41.76, "って"], [41.76, 42.12, "信"], [42.12, 42.32, "仰"], [42.32, 42.48, "に"], [42.48, 42.56, "よ"], [42.56, 42.82, "って"], [42.82, 43.06, "与"], [43.06, 43.2, "え"], [43.2, 43.34, "ら"], [43.34, 43.46, "れる"], [43.46, 43.62, "もの"], [43.62, 43.84, "だ"], [43.84, 44.22, "と"], [44.22, 44.42, "訴"], [44.42, 44.56, "え"], [44.56, 44.68, "た"], [44.68, 44.96, "んです。"]]}, {"start": 45.46, "end": 48.48, "text": "この改革の流れから生まれたのがプロテスタント。", "words": [[45.46, 45.66, "この"], [45.66, 45.9, "改"], [45.9, 46.04, "革"], [46.04, 46.22, "の"], [46.22, 46.4, "流"], [46.4, 46.54, "れ"], [46.54, 46.72, "から"], [46.72, 46.92, "生"], [46.92, 46.98, "ま"], [46.98, 47.12, "れた"], [47.12, 47.28, "の"], [47.28, 47.52, "が"], [47.52, 47.86, "プ"], [47.86, 47.94, "ロ"], [47.94, 48.08, "テ"], [48.08, 48.2, "ス"], [48.2, 48.28, "タ"], [48.28, 48.48, "ント。"]]}, {"start": 49.14, "end": 55.7, "text": "抗議する人たちという意味です。日本には1549年にザビエルがカトリックを伝えました。", "words": [[49.14, 49.34, "抗"], [49.34, 49.48, "議"], [49.48, 49.66, "する"], [49.66, 49.88, "人"], [49.88, 50.04, "た"], [50.04, 50.24, "ち"], [50.24, 50.6, "という"], [50.6, 50.84, "意"], [50.84, 50.9, "味"], [50.9, 51.16, "です。"], [51.34, 51.54, "日本"], [51.54, 51.9, "には"], [51.9, 52.46, "15"], [52.46, 53.04, "49"], [53.04, 53.54, "年"], [53.54, 53.8, "に"], [53.8, 54.14, "ザ"], [54.14, 54.26, "ビ"], [54.26, 54.34, "エ"], [54.34, 54.42, "ル"], [54.42, 54.56, "が"], [54.56, 54.7, "カ"], [54.7, 54.76, "ト"], [54.76, 54.88, "リ"], [54.88, 55.02, "ック"], [55.02, 55.14, "を"], [55.14, 55.34, "伝"], [55.34, 55.44, "え"], [55.44, 55.7, "ました。"]]}, {"start": 56.14, "end": 62.02, "text": "プロテスタントの宣教師がやってきたのは、江戸時代の終わり1859年のことです。", "words": [[56.14, 56.46, "プ"], [56.46, 56.6, "ロ"], [56.6, 56.7, "テ"], [56.7, 56.82, "ス"], [56.82, 56.9, "タ"], [56.9, 57.02, "ント"], [57.02, 57.16, "の"], [57.16, 57.38, "宣"], [57.38, 57.54, "教"], [57.54, 57.7, "師"], [57.7, 57.8, "が"], [57.8, 58.0, "やって"], [58.0, 58.24, 