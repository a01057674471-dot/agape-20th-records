[{"start": 0.0, "end": 7.42, "text": "もし神様がエヴァがあの身を食べることを知っていたのなら、どうしてあの木を取り除かなかったのでしょう。", "words": [[0.0, 0.44, "もし"], [0.44, 0.74, "神"], [0.74, 0.98, "様"], [0.98, 1.42, "が"], [1.42, 1.74, "エ"], [1.74, 1.78, "ヴ"], [1.78, 1.84, "ァ"], [1.84, 1.96, "が"], [1.96, 2.2, "あの"], [2.2, 2.32, "身"], [2.32, 2.42, "を"], [2.42, 2.56, "食べ"], [2.56, 2.74, "る"], [2.74, 2.88, "こと"], [2.88, 3.16, "を"], [3.16, 3.52, "知"], [3.52, 3.72, "って"], [3.72, 3.88, "いた"], [3.88, 3.98, "の"], [3.98, 4.22, "なら、"], [4.66, 4.96, "どう"], [4.96, 5.38, "して"], [5.38, 5.8, "あの"], [5.8, 5.98, "木"], [5.98, 6.12, "を"], [6.12, 6.26, "取"], [6.26, 6.38, "り"], [6.38, 6.48, "除"], [6.48, 6.7, "かな"], [6.7, 6.92, "かった"], [6.92, 7.16, "ので"], [7.16, 7.42, "しょう。"]]}, {"start": 7.7, "end": 16.3, "text": "その先に争いも病いも別れも来ると知っていたのに、それでも神様はあの木をそのの真ん中に残しました。", "words": [[7.7, 7.9, "その"], [7.9, 8.12, "先"], [8.12, 8.42, "に"], [8.42, 8.9, "争"], [8.9, 9.1, "い"], [9.1, 9.26, "も"], [9.26, 9.68, "病"], [9.68, 9.86, "い"], [9.86, 10.16, "も"], [10.16, 10.5, "別"], [10.5, 10.62, "れ"], [10.62, 10.82, "も"], [10.82, 11.14, "来"], [11.14, 11.28, "る"], [11.28, 11.38, "と"], [11.38, 11.58, "知"], [11.58, 11.74, "って"], [11.74, 11.9, "いた"], [11.9, 12.02, "の"], [12.02, 12.2, "に、"], [12.6, 12.84, "それ"], [12.84, 13.08, "でも"], [13.08, 13.3, "神"], [13.3, 13.5, "様"], [13.5, 13.74, "は"], [13.74, 14.24, "あの"], [14.24, 14.46, "木"], [14.46, 14.66, "を"], [14.66, 15.06, "その"], [15.06, 15.22, "の"], [15.22, 15.38, "真"], [15.38, 15.46, "ん"], [15.46, 15.58, "中"], [15.58, 15.74, "に"], [15.74, 15.88, "残"], [15.88, 16.3, "しました。"]]}, {"start": 16.68, "end": 20.44, "text": "ここに多くの人が見落としている一つの事実があります。", "words": [[16.68, 16.82, "ここ"], [16.82, 17.12, "に"], [17.12, 17.54, "多"], [17.54, 17.7, "く"], [17.7, 17.8, "の"], [17.8, 17.92, "人"], [17.92, 18.12, "が"], [18.12, 18.26, "見"], [18.26, 18.36, "落"], [18.36, 18.46, "と"], [18.46, 18.62, "して"], [18.62, 18.88, "いる"], [18.88, 19.36, "一"], [19.36, 19.56, "つ"], [19.56, 19.7, "の"], [19.7, 19.84, "事"], [19.84, 20.02, "実"], [20.02, 20.16, "が"], [20.16, 20.44, "あります。"]]}, {"start": 21.06, "end": 28.2, "text": "人がそのを出た後、神様は命の木の前に天使と炎のつるぎを置いて守らせました。", "words": [[21.06, 21.28, "人"], [21.28, 21.46, "が"], [21.46, 21.64, "その"], [21.64, 21.82, "を"], [21.82, 21.94, "出"], [21.94, 22.08, "た"], [22.08, 22.3, "後、"], [22.72, 22.9, "神"], [22.9, 23.16, "様"], [23.16, 23.42, "は"], [23.42, 23.86, "命"], [23.86, 24.16, "の"], [24.16, 24.3, "木"], [24.3, 24.42, "の"], [24.42, 24.6, "前"], [24.6, 25.04, "に"], [25.04, 25.36, "天"], [25.36, 25.5, "使"], [25.5, 25.8, "と"], [25.8, 26.12, "炎"], [26.12, 26.36, "の"], [26.36, 26.54, "つ"], [26.54, 26.62, "る"], [26.62, 26.74, "ぎ"], [26.74, 26.88, "を"], [26.88, 27.02, "置"], [27.02, 27.4, "いて"], [27.4, 27.66, "守"], [27.66, 27.8, "ら"], [27.8, 27.9, "せ"], [27.9, 28.2, "ました。"]]}, {"start": 28.779999999999998, "end": 35.08, "text": "神様は木を守る方法をちゃんと知っていたんです。でもあの木だけは守らなかった。", "words": [[28.779999999999998, 29.18, "神"], [29.18, 29.4, "様"], [29.4, 29.6, "は"], [29.6, 30.02, "木"], [30.02, 30.12, "を"], [30.12, 30.3, "守"], [30.3, 30.46, "る"], [30.46, 30.66, "方"], [30.66, 30.9, "法"], [30.9, 31.08, "を"], [31.08, 31.48, "ちゃん"], [31.48, 31.66, "と"], [31.66, 31.82, "知"], [31.82, 32.0, "って"], [32.0, 32.16, "いた"], [32.16, 32.5, "んです。"], [32.76, 33.06, "でも"], [33.06, 33.6, "あの"], [33.6, 33.8, "木"], [33.8, 33.96, "だけ"], [33.96, 34.2, "は"], [34.2, 34.56, "守"], [34.56, 34.68, "ら"], [34.68, 34.78, "な"], [34.78, 35.08, "かった。"]]}, {"start": 35.62, "end": 43.16, "text": "なぜなら、木を取り除いても罪は無くならないから。問題は木ではなく人の心にあるからです。", "words": [[35.62, 35.8, "な"], [35.8, 35.92, "ぜ"], [35.92, 36.14, "なら、"], [36.56, 36.66, "木"], [36.66, 36.8, "を"], [36.8, 36.9, "取"], [36.9, 37.0, "り"], [37.0, 37.1, "除"], [37.1, 37.34, "いて"], [37.34, 37.56, "も"], [37.56, 38.06, "罪"], [38.06, 38.3, "は"], [38.3, 38.62, "無"], [38.62, 38.74, "く"], [38.74, 38.84, "なら"], [38.84, 39.1, "ない"], [39.1, 39.3, "から。"], [39.86, 40.16, "問題"], [40.16, 40.56, "は"], [40.56, 40.86, "木"], [40.86, 41.04, "では"], [41.04, 41.32, "なく"], [41.32, 41.88, "人"], [41.88, 42.08, "の"], [42.08, 42.28, "心"], [42.28, 42.52, "に"], [42.52, 42.68, "ある"], [42.68, 42.86, "から"], [42.86, 43.16, "です。"]]}, {"start": 43.38, "end": 50.78, "text": "もし神様が間違えそうなものを全部取り除いたら、それは守られた世界ではなく取り過ごです。", "words": [[43.38, 43.58, "もし"], [43.58, 43.86, "神"], [43.86, 44.1, "様"], [44.1, 44.34, "が"], [44.34, 44.74, "間"], [44.74, 44.88, "違"], [44.88, 45.02, "え"], [45.02, 45.16, "そう"], [45.16, 45.32, "な"], [45.32, 45.48, "もの"], [45.48, 45.78, "を"], [45.78, 46.14, "全部"], [46.14, 46.42, "取"], [46.42, 46.54, "り"], [46.54, 46.62, "除"], [46.62, 46.86, "いた"], [46.86, 47.22, "ら、"], [47.66, 48.04, "それは"], [48.04, 48.6, "守"], [48.6, 48.76, "ら"], [48.76, 48.94, "れた"], [48.94, 49.18, "世界"], [49.18, 49.42, "では"], [49.42, 49.74, "なく"], [49.74, 50.24, "取"], [50.24, 50.38, "り"], [50.38, 50.44, "過"], [50.44, 50.52, "ご"], [50.52, 50.78, "です。"]]}, {"start": 50.96, "end": 57.48, "text": "神様が欲しかったのは閉じ込められて従う人ではなく、自分で選んで愛してくれる子供たちでした。", "words": [[50.96, 51.14, "神"], [51.14, 51.34, "様"], [51.34, 51.5, "が"], [51.5, 51.62, "欲"], [51.62, 51.76, "し"], [51.76, 51.92, "かった"], [51.92, 52.2, "のは"], [52.2, 52.68, "閉"], [52.68, 52.8, "じ"], [52.8, 52.9, "込"], [52.9, 53.04, "め"], [53.04, 53.1, "ら"], [53.1, 53.3, "れて"], [53.3, 53.56, "従"], [53.56, 53.74, "う"], [53.74, 53.86, "人"], [53.86, 54.1, "では"], [54.1, 54.34, "なく、"], [54.62, 55.0, "自"], [55.0, 55.2, "分"], [55.2, 55.34, "で"], [55.34, 55.5, "選"], [55.5, 55.78, "んで"], [55.78, 56.2, "愛"], [56.2, 56.42, "して"], [56.42, 56.6, "く"], [56.6, 56.72, "れる"], [56.72, 56.92, "子"], [56.92, 57.06, "供"], [57.06, 57.14, "た"], [57.14, 57.26, "ち"], [57.26, 57.48, "でした。"]]}, {"start": 57.48, "end": 63.78, "text": "聖書の中で神様は言います。私は命と死をあなたの前に置く。", "words": [[57.48, 58.06, "聖"], [58.06, 58.2, "書"], [58.2, 58.3, "の"], [58.3, 58.46, "中"], [58.46, 58.72, "で"], [58.72, 59.1, "神"], [59.1, 59.32, "様"], [59.32, 59.5, "は"], [59.5, 59.62, "言"], [59.62, 59.92, "います。"], [60.3, 60.72, "私"], [60.72, 61.0, "は"], [61.0, 61.42, "命"], [61.42, 61.7, "と"], [61.7, 61.94, "死"], [61.94, 62.1, "を"], [62.