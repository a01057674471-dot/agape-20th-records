[
 {
  "text": "러닝 끝나고 이거 하면, 뛴 거 손해 봐요.",
  "t0": 0.2,
  "t1": 1.8599999999999999
 },
 {
  "text": "하나, 바로 주저앉기.",
  "t0": 1.88,
  "t1": 2.9
 },
 {
  "text": "어지러울 수 있어요.",
  "t0": 2.92,
  "t1": 3.7
 },
 {
  "text": "3~5분은 천천히 걸어요.",
  "t0": 3.95,
  "t1": 5.36
 },
 {
  "text": "둘, 땀에 젖은 옷 그대로.",
  "t0": 5.4,
  "t1": 6.5
 },
 {
  "text": "몸이 식고 피부 트러블이 생길 수 있어요.",
  "t0": 6.52,
  "t1": 8.11
 },
 {
  "text": "바로 갈아입어요.",
  "t0": 8.17,
  "t1": 9.07
 },
 {
  "text": "셋, 바로 뜨거운 샤워나 사우나.",
  "t0": 9.34,
  "t1": 10.780000000000001
 },
 {
  "text": "숨부터 고르고, 미지근한 물로 시작해요.",
  "t0": 10.8,
  "t1": 12.66
 },
 {
  "text": "넷, 물 안 마시기, 또는 한 번에 벌컥벌컥.",
  "t0": 12.68,
  "t1": 14.55
 },
 {
  "text": "조금씩 나눠 마셔요.",
  "t0": 14.57,
  "t1": 15.55
 },
 {
  "text": "다섯, 뛰었으니까 맥주 한 잔?",
  "t0": 15.57,
  "t1": 16.91
 },
 {
  "text": "수분이 더 빠지고 회복이 느려져요.",
  "t0": 16.93,
  "t1": 18.43
 },
 {
  "text": "물과 식사 먼저.",
  "t0": 18.45,
  "t1": 19.27
 },
 {
  "text": "잘 뛰는 것만큼, 잘 끝내는 게 실력.",
  "t0": 19.69,
  "t1": 21.57
 },
 {
  "text": "몇 개 해당돼요?",
  "t0": 21.59,
  "t1": 22.38
 },
 {
  "text": "댓글로 알려 주세요.",
  "t0": 22.4,
  "t1": 23.34
 }
]