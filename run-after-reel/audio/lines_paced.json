[
 {
  "text": "러닝 끝나고 이거 하면, 뛴 거 손해 봐요.",
  "t0": 0.2,
  "t1": 1.86
 },
 {
  "text": "하나, 바로 주저앉기.",
  "t0": 2.33,
  "t1": 3.35
 },
 {
  "text": "어지러울 수 있어요.",
  "t0": 3.37,
  "t1": 4.15
 },
 {
  "text": "3~5분은 천천히 걸어요.",
  "t0": 4.4,
  "t1": 5.81
 },
 {
  "text": "둘, 땀에 젖은 옷 그대로.",
  "t0": 6.75,
  "t1": 7.85
 },
 {
  "text": "몸이 식고 피부 트러블이 생길 수 있어요.",
  "t0": 7.87,
  "t1": 9.46
 },
 {
  "text": "바로 갈아입어요.",
  "t0": 9.52,
  "t1": 10.42
 },
 {
  "text": "셋, 바로 뜨거운 샤워나 사우나.",
  "t0": 11.59,
  "t1": 13.03
 },
 {
  "text": "숨부터 고르고, 미지근한 물로 시작해요.",
  "t0": 13.05,
  "t1": 14.91
 },
 {
  "text": "넷, 물 안 마시기, 또는 한 번에 벌컥벌컥.",
  "t0": 15.83,
  "t1": 17.7
 },
 {
  "text": "조금씩 나눠 마셔요.",
  "t0": 17.72,
  "t1": 18.7
 },
 {
  "text": "다섯, 뛰었으니까 맥주 한 잔?",
  "t0": 19.62,
  "t1": 20.96
 },
 {
  "text": "수분이 더 빠지고 회복이 느려져요.",
  "t0": 20.98,
  "t1": 22.48
 },
 {
  "text": "물과 식사 먼저.",
  "t0": 22.5,
  "t1": 23.32
 },
 {
  "text": "잘 뛰는 것만큼, 잘 끝내는 게 실력.",
  "t0": 24.74,
  "t1": 26.62
 },
 {
  "text": "몇 개 해당돼요?",
  "t0": 26.64,
  "t1": 27.43
 },
 {
  "text": "댓글로 알려 주세요.",
  "t0": 27.45,
  "t1": 28.39
 }
]